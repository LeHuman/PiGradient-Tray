{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build (debug)",
      "type": "shell",
      "command": "cargo build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: build (release)",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: test",
      "type": "shell",
      "command": "cargo test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: install local",
      "type": "shell",
      "command": "cargo install --path .",
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
