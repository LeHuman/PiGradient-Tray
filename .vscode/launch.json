{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PiGradient Tray (Windows MSVC - cppvsdbg)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/pigradient-tray.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "cargo: build (debug)",
      "sourceFileMap": {
        "/rustc": "${env:USERPROFILE}/.rustup/toolchains/stable-x86_64-pc-windows-msvc/lib/rustlib/src/rust"
      }
    },
    {
      "name": "Debug PiGradient Tray (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=pigradient-tray"]
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Attach to PiGradient Tray (Windows MSVC)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
